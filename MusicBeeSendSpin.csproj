<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>mb_SendSpin</AssemblyName>
    <RootNamespace>MusicBeePlugin</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- Bundle all dependency dlls (managed + native libsodium) into mb_SendSpin.dll -->
  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Noise.NET" Version="1.0.0" />
    <PackageReference Include="libsodium" Version="1.0.22" />
    <PackageReference Include="System.Memory" Version="4.5.4" />
  </ItemGroup>

  <!-- Native libsodium: pulled from the libsodium NuGet package (see PackageReference above); -->
  <!-- embedded as an unmanaged assembly (Costura extracts + LoadLibrary's it at module init). -->
  <PropertyGroup>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == ''">$(UserProfile)/.nuget/packages/</NuGetPackageRoot>
    <LibsodiumPkgDir>$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)', 'libsodium', '1.0.22', 'runtimes'))</LibsodiumPkgDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$([MSBuild]::NormalizePath('$(LibsodiumPkgDir)', 'win-x86', 'native', 'libsodium.dll'))">
      <LogicalName>costura_win_x86.libsodium.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$([MSBuild]::NormalizePath('$(LibsodiumPkgDir)', 'win-x64', 'native', 'libsodium.dll'))">
      <LogicalName>costura_win_x64.libsodium.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The interop test has its own csproj; keep its files out of the plugin build. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

  <!-- Costura embeds these into mb_SendSpin.dll; drop the loose copies from the output dir. -->
  <Target Name="RemoveEmbeddedCosturaFiles" AfterTargets="AfterBuild">
    <ItemGroup>
      <EmbeddedDlls Include="$(OutputPath)Costura.dll" />
      <EmbeddedDlls Include="$(OutputPath)Makaretu.Dns.dll" />
      <EmbeddedDlls Include="$(OutputPath)Makaretu.Dns.Multicast.dll" />
      <EmbeddedDlls Include="$(OutputPath)SimpleBase.dll" />
      <EmbeddedDlls Include="$(OutputPath)Newtonsoft.Json.dll" />
      <EmbeddedDlls Include="$(OutputPath)Noise.dll" />
      <EmbeddedDlls Include="$(OutputPath)System.Buffers.dll" />
      <EmbeddedDlls Include="$(OutputPath)System.Diagnostics.DiagnosticSource.dll" />
      <EmbeddedDlls Include="$(OutputPath)System.Memory.dll" />
      <EmbeddedDlls Include="$(OutputPath)System.Net.IPNetwork.dll" />
      <EmbeddedDlls Include="$(OutputPath)System.Numerics.Vectors.dll" />
      <EmbeddedDlls Include="$(OutputPath)Common.Logging.dll" />
      <EmbeddedDlls Include="$(OutputPath)Common.Logging.Core.dll" />
      <EmbeddedDlls Include="$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll" />
      <EmbeddedDlls Include="$(OutputPath)System.ValueTuple.dll" />
      <EmbeddedDlls Include="$(OutputPath)libsodium.dll" />
      <EmbeddedDlls Include="$(OutputPath)x64\libsodium.dll" />
      <EmbeddedDlls Include="$(OutputPath)x86\libsodium.dll" />
    </ItemGroup>
    <Delete Files="@(EmbeddedDlls)" />
  </Target>

</Project>
