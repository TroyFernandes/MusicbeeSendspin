<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>noise-interop</AssemblyName>
    <RootNamespace>noise_interop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The plugin's Noise framing under test (self-contained: System.*, Newtonsoft, Noise.NET). -->
    <Compile Include="../../SendSpin/Noise/WireFraming.cs" Link="Src/WireFraming.cs" />
    <Compile Include="../../SendSpin/Noise/NoiseSupport.cs" Link="Src/NoiseSupport.cs" />
    <Compile Include="../../SendSpin/Noise/NoiseWireFraming.cs" Link="Src/NoiseWireFraming.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Noise.NET" Version="1.0.0" />
    <PackageReference Include="libsodium" Version="1.0.22" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
